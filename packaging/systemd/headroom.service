[Unit]
Description=Headroom AI coding limits daemon
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.headroom.Daemon
ExecStart=%h/.local/bin/headroom daemon
Restart=on-failure
RestartSec=5
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_MMAP_THRESHOLD_=131072

[Install]
WantedBy=default.target
