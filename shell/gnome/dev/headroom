#!/usr/bin/env python3
import argparse
import json
import os
import select
import sys
import time

SIGN_IN_URL = "https://auth.example.com/oauth/authorize?client_id=headroom-dev&state=mock"
STEP_SECONDS = float(os.environ.get("HEADROOM_FAKE_STEP", "1.2"))


def emit(event, **fields):
    print(json.dumps({"event": event, **fields}), flush=True)


def wait_for_code(timeout):
    ready, _, _ = select.select([sys.stdin], [], [], timeout)
    if not ready:
        return None
    return sys.stdin.readline().strip() or None


def record(entry):
    log = os.environ.get("HEADROOM_FAKE_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(entry) + "\n")


def add_key(args):
    key = sys.stdin.readline().strip()
    rest = sys.stdin.read()
    record({"argv": sys.argv[1:], "stdin_key": key, "stdin_closed": rest == ""})
    time.sleep(STEP_SECONDS)
    if not key or key == "bad":
        emit("error", message=f"{args.provider} rejected the key (HTTP 401)")
        return 1
    home = f"/tmp/headroom-fake/accounts/{args.provider}/0123456789ab"
    emit("started", provider=args.provider, home=home)
    time.sleep(STEP_SECONDS / 2)
    emit("done", account_id=f"{args.provider}:0123456789ab", label=args.label)
    return 0


def add(args):
    if args.api_key_stdin:
        return add_key(args)
    emit("started", provider=args.provider, label=args.label)
    time.sleep(STEP_SECONDS)
    emit("output", line=f"Starting {args.provider} sign-in in a Headroom-owned home")
    emit("url", url=SIGN_IN_URL)
    emit("output", line="Open the link above, sign in, then paste the code if the page shows one.")
    if os.environ.get("HEADROOM_FAKE_RESULT") == "error":
        time.sleep(STEP_SECONDS)
        emit("error", message="sign-in was cancelled in the browser")
        return 1
    code = wait_for_code(float(os.environ.get("HEADROOM_FAKE_WAIT", "30")))
    emit("output", line=f"Received code {code}" if code else "Browser sign-in finished")
    time.sleep(STEP_SECONDS)
    emit("output", line="Verifying account…")
    time.sleep(STEP_SECONDS)
    emit("done", account_id=f"{args.provider}:0123456789ab")
    return 0


def dismiss(account_id):
    from gi.repository import Gio, GLib

    Gio.bus_get_sync(Gio.BusType.SESSION).call_sync(
        "io.github.daniarjabagin.Headroom", "/io/github/daniarjabagin/Headroom", "io.github.daniarjabagin.Headroom1", "DismissAccount",
        GLib.Variant("(s)", (account_id,)), None, Gio.DBusCallFlags.NONE, -1, None,
    )


def remove(args):
    emit("started", account_id=args.id)
    time.sleep(STEP_SECONDS)
    try:
        dismiss(args.id)
    except Exception as error:
        emit("error", message=str(error))
        return 1
    emit("output", line=f"Headroom no longer shows {args.id}")
    emit("done", account_id=args.id)
    return 0


UPDATE_STEPS = ["Checking for a new release…", "Downloading Headroom 0.5.0…", "Verifying the checksum…", "Unpacking…",
                "Installing /home/ada/.local/bin/headroom"]


def update(_args):
    for step in UPDATE_STEPS:
        emit("step", text=step)
        time.sleep(STEP_SECONDS)
        if os.environ.get("HEADROOM_FAKE_RESULT") == "error" and step.startswith("Verifying"):
            emit("error", message="checksum mismatch for headroom-0.5.0-x86_64-linux.tar.gz")
            return 1
    emit("done", version="0.5.0", relogin=True)
    return 0


def run(args):
    if args.command == "update":
        return update(args)
    return add(args) if args.action == "add" else remove(args)


def main():
    parser = argparse.ArgumentParser(prog="headroom", description="Fake headroom CLI for the GNOME dev kit.")
    commands = parser.add_subparsers(dest="command", required=True)
    accounts = commands.add_parser("accounts").add_subparsers(dest="action", required=True)
    add_parser = accounts.add_parser("add")
    add_parser.add_argument("provider")
    add_parser.add_argument("--label")
    add_parser.add_argument("--api-key-stdin", action="store_true")
    add_parser.add_argument("--progress", choices=["json"])
    remove_parser = accounts.add_parser("remove")
    remove_parser.add_argument("id")
    remove_parser.add_argument("--yes", action="store_true")
    remove_parser.add_argument("--progress", choices=["json"])
    update_parser = commands.add_parser("update")
    update_parser.add_argument("--yes", action="store_true")
    update_parser.add_argument("--progress", choices=["json"])
    sys.exit(run(parser.parse_args()))


if __name__ == "__main__":
    main()
